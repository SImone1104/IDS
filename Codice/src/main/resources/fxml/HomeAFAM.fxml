<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.afam.gestioneAutenticazione.interfaccia.HomeAFAM"
      alignment="CENTER" spacing="12" prefWidth="460" prefHeight="460">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>
    <children>
        <Label text="Home AFAM" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        <Button text="Ricerca" prefWidth="260" onAction="#cliccaRicerca"/>
        <Button text="Gestione Profilo" prefWidth="260" onAction="#cliccaGestioneProfilo"/>
        <Button text="Gestione Portfolio" prefWidth="260" onAction="#cliccaGestionePortfolio"/>
        <Button text="Gestione Contenuti" prefWidth="260" onAction="#cliccaGestioneContenuti"/>
        <Button text="Gestione Condivisione con Link" prefWidth="260" onAction="#cliccaGestioneCondLink"/>
        <Button text="Gestione Condivisione Interna" prefWidth="260" onAction="#cliccaGestCondInterna"/>
        <Button text="Logout" prefWidth="260" onAction="#cliccaLogout"/>
    </children>
</VBox>
