<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.afam.gestioneCondivisione.interfaccia.SchermataGenerazioneCodice"
      alignment="CENTER" spacing="16" prefWidth="420" prefHeight="220">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>
    <children>
        <Label text="Generazione Codice" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Label text="Genera un codice per i contenuti privati selezionati"/>
        <Button text="Genera Codice" prefWidth="200" onAction="#cliccaGeneraCodice"/>
        <Button text="Indietro" prefWidth="200" onAction="#cliccaIndietro"/>
    </children>
</VBox>
