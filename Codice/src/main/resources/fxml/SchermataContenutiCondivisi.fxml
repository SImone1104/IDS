<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.afam.consultazione.interfaccia.SchermataContenutiCondivisi"
      alignment="CENTER" spacing="12" prefWidth="500" prefHeight="400">
    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>
    <children>
        <Label text="Contenuti Condivisi" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        <ListView fx:id="listaFile" prefHeight="240"/>
        <HBox alignment="CENTER" spacing="15">
            <children>
                <Button text="Visualizza" onAction="#cliccaVisualizza"/>
                <Button text="Indietro" onAction="#cliccaIndietro"/>
            </children>
        </HBox>
    </children>
</VBox>
