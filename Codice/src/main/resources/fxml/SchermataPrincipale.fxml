<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.afam.gestioneAutenticazione.interfaccia.SchermataPrincipale"
      alignment="CENTER" spacing="18" prefWidth="420" prefHeight="320">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
    <children>
        <Label text="AFAM Connect" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Button text="Login" prefWidth="220" onAction="#cliccaLogin"/>
        <Button text="Registrati" prefWidth="220" onAction="#cliccaRegistrazione"/>
        <Button text="Recupera Password" prefWidth="220" onAction="#cliccaRecuperaPassword"/>
        <Button text="Ricerca" prefWidth="220" onAction="#cliccaRicerca"/>
    </children>
</VBox>
