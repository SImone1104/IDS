<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.afam.gestioneStudente.interfaccia.SchermataUpload"
      alignment="CENTER" spacing="12" prefWidth="460" prefHeight="360">
    <padding><Insets top="25" right="40" bottom="25" left="40"/></padding>
    <children>
        <Label text="Caricamento File" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <TextField fx:id="campoTitolo" promptText="Titolo"/>
        <TextArea fx:id="campoDescrizione" promptText="Descrizione" prefRowCount="3" wrapText="true"/>
        <HBox alignment="CENTER" spacing="10">
            <children>
                <Button fx:id="bottoneScegliFile" text="Scegli File" onAction="#cliccaScegliFile"/>
                <Label fx:id="labelFile" text="(nessun file selezionato)"/>
            </children>
        </HBox>
        <ProgressIndicator fx:id="indicatoreCaricamento" prefWidth="38" prefHeight="38"
                           visible="false" managed="false"/>
        <Label fx:id="labelCaricamento" text="Caricamento file in corso..."
               visible="false" managed="false"/>
        <HBox alignment="CENTER" spacing="15">
            <children>
                <Button fx:id="bottoneConferma" text="Conferma" onAction="#cliccaConferma"/>
                <Button fx:id="bottoneAnnulla" text="Annulla" onAction="#cliccaAnnulla"/>
            </children>
        </HBox>
    </children>
</VBox>
