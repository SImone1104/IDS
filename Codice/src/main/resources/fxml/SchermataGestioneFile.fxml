<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.afam.gestioneStudente.interfaccia.SchermataGestioneFile"
      alignment="CENTER" spacing="14" prefWidth="400" prefHeight="300">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>
    <children>
        <Label text="Opzioni File" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Button text="Modifica File" prefWidth="220" onAction="#cliccaModificaFile"/>
        <Button text="Privacy" prefWidth="220" onAction="#cliccaPrivacy"/>
        <Button text="Elimina File" prefWidth="220" onAction="#cliccaEliminaFile"/>
        <Button text="Indietro" prefWidth="220" styleClass="secondary-action" onAction="#cliccaIndietro"/>
    </children>
</VBox>
