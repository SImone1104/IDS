<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.afam.gestioneStudente.interfaccia.SchermataDatiPersonali"
      alignment="CENTER" spacing="22" prefWidth="720" prefHeight="430">
    <padding><Insets top="34" right="44" bottom="34" left="44"/></padding>
    <children>
        <Label text="Dati Personali" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

        <HBox alignment="CENTER" spacing="34">
            <children>
                <VBox alignment="CENTER" spacing="10" prefWidth="230">
                    <children>
                        <ImageView fx:id="fotoProfilo" fitWidth="190" fitHeight="190" preserveRatio="true"
                                   style="-fx-effect: dropshadow(gaussian, rgba(24, 52, 90, 0.20), 12, 0.18, 0, 4);"/>
                        <Label fx:id="labelFoto" text="Foto profilo" wrapText="true"
                               style="-fx-text-fill: #667085; -fx-font-size: 12px;"/>
                    </children>
                </VBox>

                <VBox alignment="CENTER_LEFT" spacing="12" prefWidth="360">
                    <children>
                        <Label fx:id="labelNome" style="-fx-font-size: 15px;"/>
                        <Label fx:id="labelCognome" style="-fx-font-size: 15px;"/>
                        <Label fx:id="labelEmail" style="-fx-font-size: 15px;" wrapText="true"/>
                        <Label fx:id="labelTelefono" style="-fx-font-size: 15px;"/>
                    </children>
                </VBox>
            </children>
        </HBox>

        <Region prefHeight="6"/>

        <HBox alignment="CENTER" spacing="15">
            <children>
                <Button text="Modifica Dati" prefWidth="150" onAction="#cliccaModificaDati"/>
                <Button text="Indietro" prefWidth="150" styleClass="secondary-action" onAction="#cliccaIndietro"/>
            </children>
        </HBox>
    </children>
</VBox>
