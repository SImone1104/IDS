<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.afam.consultazione.interfaccia.SchermataRicerca"
      alignment="CENTER" spacing="14" prefWidth="440" prefHeight="300">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>
    <children>
        <Label text="Ricerca Studente" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        <TextField fx:id="campoNome" promptText="Nome"/>
        <TextField fx:id="campoCognome" promptText="Cognome"/>
        <Button text="Cerca" prefWidth="160" onAction="#cliccaCerca"/>
        <Button text="Indietro" prefWidth="160" onAction="#cliccaIndietro"/>
    </children>
</VBox>
