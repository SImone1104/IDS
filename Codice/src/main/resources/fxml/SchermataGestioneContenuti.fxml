<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.afam.gestioneStudente.interfaccia.SchermataGestioneContenuti"
      alignment="CENTER" spacing="12" prefWidth="500" prefHeight="400">
    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>
    <children>
        <Label text="Gestione Contenuti" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        <Label text="Le tue categorie artistiche:"/>
        <ListView fx:id="listaCategorie" prefHeight="220"/>
        <HBox alignment="CENTER" spacing="12">
            <children>
                <Button text="Apri" onAction="#cliccaApriCategoria"/>
                <Button text="Crea Nuova Categoria" onAction="#cliccaCreaNuovaCategoria"/>
                <Button text="Indietro" onAction="#cliccaIndietro"/>
            </children>
        </HBox>
    </children>
</VBox>
