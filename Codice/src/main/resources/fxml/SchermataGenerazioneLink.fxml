<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.afam.gestioneCondivisione.interfaccia.SchermataGenerazioneLink"
      alignment="CENTER" spacing="16" prefWidth="420" prefHeight="220">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>
    <children>
        <Label text="Generazione Link" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Label text="Genera un link per i contenuti selezionati"/>
        <ProgressIndicator fx:id="indicatoreCaricamento" prefWidth="38" prefHeight="38"
                           visible="false" managed="false"/>
        <Label fx:id="labelCaricamento" text="Generazione link in corso..."
               visible="false" managed="false"/>
        <Button fx:id="bottoneGenera" text="Genera Link" prefWidth="200" onAction="#cliccaGeneraLink"/>
        <Button fx:id="bottoneIndietro" text="Indietro" prefWidth="200" styleClass="secondary-action" onAction="#cliccaIndietro"/>
    </children>
</VBox>
