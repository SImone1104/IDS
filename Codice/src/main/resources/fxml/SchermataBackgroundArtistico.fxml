<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.afam.gestioneStudente.interfaccia.SchermataBackgroundArtistico"
      alignment="CENTER" spacing="12" prefWidth="620" prefHeight="560">
    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>
    <children>
        <Label text="Background Artistico" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        <ListView fx:id="listaBackground" prefHeight="360"/>
        <HBox alignment="CENTER" spacing="12">
            <children>
                <Button text="Aggiungi" onAction="#cliccaAggiungiDati"/>
                <Button text="Modifica" onAction="#cliccaModificaDati"/>
                <Button text="Elimina" onAction="#cliccaEliminaDati"/>
                <Button text="Indietro" styleClass="secondary-action" onAction="#cliccaIndietro"/>
            </children>
        </HBox>
    </children>
</VBox>
