        </mxCell>
        <mxCell id="Z5MlBauUrw-qMo_bMukO-13" parent="Z5MlBauUrw-qMo_bMukO-11" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=center;" value="&lt;div style=&quot;text-align: left; font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&amp;nbsp;Il sistema &amp;nbsp;ha mostrato a schermo la schermata contenente i file&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="510" x="380" as="geometry">
            <mxRectangle height="30" width="510" as="alternateBounds" />
          </mxGeometry>
