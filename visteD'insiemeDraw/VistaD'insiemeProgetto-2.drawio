          </mxGeometry>
        </mxCell>
        <mxCell id="KL5rWk6U1-Xfj0pIhx3G-16" parent="KL5rWk6U1-Xfj0pIhx3G-14" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;1.Il tempo interroga il sistema sulla data odierna&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;2.Se l&#39;orario corrisponde alle 00:00&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; 2.1Il sistema interroga il dbms per recuperare la data di scadenza&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; 2.2Se la data odierna è maggiore della data di scadenza&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 2.2.1 Il sistema aggiorna il dbms rendendo il link disattivato&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="172" width="490" x="320" as="geometry">
            <mxRectangle height="172" width="490" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="KL5rWk6U1-Xfj0pIhx3G-17" parent="KL5rWk6U1-Xfj0pIhx3G-1" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1">
          <mxGeometry height="45" width="810" y="300" as="geometry" />
        </mxCell>
        <mxCell id="KL5rWk6U1-Xfj0pIhx3G-18" parent="KL5rWk6U1-Xfj0pIhx3G-17" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;b&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Postcondizioni&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="45" width="320" as="geometry">
            <mxRectangle height="45" width="320" as="alternateBounds" />
          </mxGeometry>
