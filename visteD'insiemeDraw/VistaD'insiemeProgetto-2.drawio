        <mxCell id="j6LiemEWmGd-EiNNAa9P-13" parent="j6LiemEWmGd-EiNNAa9P-11" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=center;" value="&lt;span style=&quot;text-align: start;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Il Sistema ha mostrato a video la schermata “Generazione codice&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;; text-align: start;&quot;&gt;”&lt;/span&gt;" vertex="1">
          <mxGeometry height="20" width="490" x="350" as="geometry">
            <mxRectangle height="20" width="490" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="j6LiemEWmGd-EiNNAa9P-14" parent="j6LiemEWmGd-EiNNAa9P-1" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="270" width="840" y="150" as="geometry" />
        </mxCell>
        <mxCell id="j6LiemEWmGd-EiNNAa9P-15" parent="j6LiemEWmGd-EiNNAa9P-14" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;b&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Flusso degli eventi&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="270" width="350" as="geometry">
            <mxRectangle height="270" width="350" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="j6LiemEWmGd-EiNNAa9P-16" parent="j6LiemEWmGd-EiNNAa9P-14" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;1.&amp;nbsp;&lt;/b&gt;Lo studente clicca sul pulsante “Genera Codice”.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;2.&amp;nbsp;&lt;/b&gt;Il Sistema genera un codice univoco associato ai file selezionati.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;3.&amp;nbsp;&lt;/b&gt;Il Sistema invia i dati del codice generato, l&#39;elenco dei file associati e l&#39;identificativo dello &amp;nbsp; &amp;nbsp; &lt;span style=&quot;white-space: pre;&quot;&gt;&amp;nbsp;   &lt;/span&gt;studente al DBMS per la memorizzazione definitiva.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;4.&amp;nbsp;&lt;/b&gt;Il Sistema mostra a video un messaggio di conferma: “Codice generato con successo”, &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;white-space: pre;&quot;&gt;&amp;nbsp;  &lt;/span&gt;contenente il codice testuale creato e i pulsanti “Copia codice” e “ok”.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;5.&amp;nbsp;&lt;/b&gt;Lo studente clicca sul pulsante “Copia codice”.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;6.&amp;nbsp;&lt;/b&gt;Il Sistema copia il codice generato nel dispositivo dello studente.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;7&lt;/b&gt;.Lo studente clicca sul pulsante “ok” per chiudere il messaggio di conferma.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;8&lt;/b&gt;.Il Sistema mostra a video la schermata “Gestione Condivisione Interna”&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="270" width="490" x="350" as="geometry">
            <mxRectangle height="270" width="490" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
