        </mxCell>
        <mxCell id="srs1qrMmc9TRxSqe3j-M-3" parent="srs1qrMmc9TRxSqe3j-M-1" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;ol&gt;&lt;li&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Il campo dove inserire il nome della categoria artistica non può essere vuoto&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Il nome della categoria artistica deve essere univoco&lt;/font&gt;&lt;br&gt;&lt;/li&gt;&lt;/ol&gt;" vertex="1">
