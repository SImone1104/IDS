          <mxGeometry height="210" width="810" y="160" as="geometry" />
        </mxCell>
        <mxCell id="CBy3kFYD3NVFpVAmzLiz-15" parent="CBy3kFYD3NVFpVAmzLiz-14" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;b&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Flusso degli eventi&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="210" width="320" as="geometry">
            <mxRectangle height="210" width="320" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="CBy3kFYD3NVFpVAmzLiz-16" parent="CBy3kFYD3NVFpVAmzLiz-14" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;b&gt;1.&lt;/b&gt;&amp;nbsp;Lo studente clicca la sezione Gestisci link&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;b&gt;2. &lt;/b&gt;&lt;b&gt;&amp;nbsp;SE&amp;nbsp;&lt;/b&gt;&amp;nbsp;lo studente non possiede alcun link generato&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;2.1 &lt;/b&gt;Il sistema mostra a schermo un messaggio di avviso che indica l&#39; assenza di link &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;generati&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;b&gt;2.2 &lt;/b&gt;Il sistema mostra a schermo la possibilita di generare link reindirizzando lo studente nella sezione Selezione Contenuti&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;b&gt;3. ALTRIMENTI&lt;/b&gt;&amp;nbsp;il sistena mostra a schermo tutti i link generati dallo studente&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;b&gt;3.1 &lt;/b&gt;Per ciascun link,il sistema mostra un pulsante deidicato alla revoca del link&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;b&gt;3.2 SE&amp;nbsp;&lt;/b&gt;&amp;nbsp;il link è stato visualizzato dall&#39; utente&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;b&gt;3.2.1 &lt;/b&gt;Il sisistema mostra accanto al link un indicatore grafico (spunta) che &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;conferma l&#39; avvenuta visualizzazione&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;b&gt;3.3 ALTRIMENTI&amp;nbsp;&lt;/b&gt;Il sistema non mostra nessun indicatore di conferma&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="210" width="490" x="320" as="geometry">
            <mxRectangle height="210" width="490" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="CBy3kFYD3NVFpVAmzLiz-17" parent="CBy3kFYD3NVFpVAmzLiz-1" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1">
