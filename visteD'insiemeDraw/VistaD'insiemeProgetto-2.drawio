        <mxCell id="i_ED-nLKWD0300X7O_kz-15" parent="i_ED-nLKWD0300X7O_kz-14" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;b&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Flusso degli eventi&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="379" width="350" as="geometry">
            <mxRectangle height="379" width="350" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i_ED-nLKWD0300X7O_kz-16" parent="i_ED-nLKWD0300X7O_kz-14" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;1&lt;/b&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;. Lo studente clicca sulla sezione &quot;Gestione condivisione tramite link&quot;.&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;2&lt;/b&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;. Il Sistema mostra a video la schermata &quot;Gestione Condivisione tramite Link&quot;.&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;3&lt;/b&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;. Lo studente clicca sul pulsante &quot;Seleziona Contenuti&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;4.Il sistema recupera dalla memoria temporanea l&#39;identificativo dello studente&lt;br&gt;&lt;/font&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;5&lt;/b&gt;. Il Sistema interroga il DBMS per recuperare la struttura dei contenuti (strumenti e file).&lt;/span&gt;&lt;br&gt;&lt;b data-path-to-node=&quot;6,4,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;6. SE&lt;/b&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&amp;nbsp;lo studente non ha alcun contenuto caricato:&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 6&lt;/span&gt;&lt;b style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;.1&lt;/b&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;. Il Sistema mostra a video il messaggio di errore: &quot;Nessun contenuto disponibile&quot;.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;; white-space: pre;&quot;&gt;&#x9;6&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;.2&lt;/b&gt;. Lo studente clicca sul pulsante &quot;ok&quot; per chiuderlo.&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;; white-space: pre;&quot;&gt;&#x9;6&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;.3&lt;/b&gt;. Il Sistema mostra nuovamente la schermata &quot;Gestione Condivisione tramite Link&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b data-path-to-node=&quot;6,5,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;7. &lt;/span&gt;ALTRIMENTI&lt;/b&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&amp;nbsp;(Ci sono contenuti disponibili):&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;b&gt;&amp;nbsp; 7.1&lt;/b&gt;. Il Sistema mostra a video la schermata &quot;Seleziona Contenuti&quot;, contenente l&#39;elenco dei contenuti &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;suddivisi per categoria e il pulsante &quot;Conferma Selezione Finale&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;    7&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;.2&lt;/b&gt;Lo studente seleziona i contenuti desiderati.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;   &lt;/span&gt;&lt;b&gt;&amp;nbsp;7.3&lt;/b&gt;&lt;/span&gt;&lt;b data-path-to-node=&quot;6,6,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;Lo studente clicca sul pulsante &quot;Conferma Selezione Finale&quot;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&amp;nbsp;  &lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;    7&lt;/span&gt;&lt;b&gt;.4&lt;/b&gt;. Il Sistema mostra a video la schermata &quot;Generazione Link&quot;.&lt;/span&gt;&lt;br&gt;&lt;p data-path-to-node=&quot;6,6,0&quot;&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;6,9,0&quot;&gt;&lt;/p&gt;&lt;p data-path-to-node=&quot;6,10,0&quot;&gt;&lt;/p&gt;&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="379" width="590" x="350" as="geometry">
            <mxRectangle height="379" width="590" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
