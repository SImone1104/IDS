        <mxCell id="KCTiOsrNAVvBlqUMDYxz-13" parent="KCTiOsrNAVvBlqUMDYxz-11" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=center;" value="&lt;font face=&quot;Times New Roman&quot;&gt;Il sistema&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;; text-align: left;&quot;&gt;&amp;nbsp;ha mostrato&lt;/span&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&amp;nbsp;a video la schermata Elenco File&lt;/font&gt;" vertex="1">
