          <mxGeometry height="75" width="380" as="geometry">
            <mxRectangle height="75" width="380" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pT3C6hA5ZdsImX64dRsF-19" parent="pT3C6hA5ZdsImX64dRsF-17" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-align: center; font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;Il sistema &amp;nbsp;mostra a schermo la schermata per la scelta della tipologia dei file&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="410" x="380" as="geometry">
