        <mxCell id="TO8d5Gn-HpzWrPPVHk-r-16" parent="TO8d5Gn-HpzWrPPVHk-r-14" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;1.&amp;nbsp;&lt;/b&gt;Lo studente clicca sul pulsante “Genera Link”.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;2.&amp;nbsp;&lt;/b&gt;Il Sistema recupera dalla memoria temporanea l&#39;elenco dei file precedentemente &lt;span style=&quot;white-space: pre;&quot;&gt;&amp;nbsp;   &lt;/span&gt;selezionati&lt;b&gt;&amp;nbsp;&lt;/b&gt;dallo studente.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;3.&amp;nbsp;&lt;/b&gt;Il Sistema genera un link di condivisione univoco associato ai file selezionati.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;4.&amp;nbsp;&lt;/b&gt;Il Sistema invia i dati del link generato, l&#39;elenco dei file associati e l&#39;identificativo dello &amp;nbsp; &amp;nbsp; &lt;span style=&quot;white-space: pre;&quot;&gt;&amp;nbsp;   &lt;/span&gt;studente al DBMS per la memorizzazione definitiva.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;5.&amp;nbsp;&lt;/b&gt;Il Sistema mostra a video un messaggio di conferma: “Link generato con successo”, &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;white-space: pre;&quot;&gt;&amp;nbsp;  &lt;/span&gt;contenente il link testuale creato e i pulsanti “Copia Link” e “ok”.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;6.&amp;nbsp;&lt;/b&gt;Lo studente clicca sul pulsante “Copia Link”.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;7.&amp;nbsp;&lt;/b&gt;Il Sistema copia il link generato nel dispositivo dello studente.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;8&lt;/b&gt;.Lo studente clicca sul pulsante “ok” per chiudere il messaggio di conferma.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;b&gt;9&lt;/b&gt;.Il Sistema mostra a video la schermata “Gestione Condivisione tramite Link”&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="270" width="490" x="350" as="geometry">
            <mxRectangle height="270" width="490" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
