          </mxGeometry>
        </mxCell>
        <mxCell id="QUuvt9lHnHT5mBKgE8wx-16" parent="QUuvt9lHnHT5mBKgE8wx-14" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&amp;nbsp; &lt;b&gt;1.&lt;/b&gt;&amp;nbsp;Lo studente clicca su &quot;+&quot; accanto al file di interesse&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&amp;nbsp; &lt;b&gt;2.&lt;/b&gt;&amp;nbsp;Il sistema mostra un menu a tendina con varie voci&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&amp;nbsp; &lt;b&gt;3.&lt;/b&gt;&amp;nbsp;Lo studente seleziona la voce &quot;ELIMINA FILE&quot;.&amp;nbsp;&lt;/div&gt;&lt;/span&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&amp;nbsp; &lt;/font&gt;&lt;b style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;4.&lt;/b&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&amp;nbsp;Il sistema mostra a schermo una finestra in cui è presente un messaggio dove si &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;chiede la conferma dell&#39;azione e si dice che l&#39;azione sarà irreversibile, ed un &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;pulsante conferma .&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;; text-align: left;&quot;&gt;&amp;nbsp; &lt;b&gt;5.&lt;/b&gt;&amp;nbsp;Lo studente clicca il pulsante &quot;Conferma&quot;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;; text-align: left;&quot;&gt;&lt;div style=&quot;font-family: Helvetica;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&amp;nbsp; 6 Il sistema recupera dalla memoria temporanea l&#39;identificativo dello studente&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;; text-align: left;&quot;&gt;&amp;nbsp; 7&lt;b&gt;.&amp;nbsp;&lt;/b&gt;Il sistema aggiorna il DBMS eliminando il file.&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;; text-align: left;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;  8. &lt;/b&gt;Il sistema mostra a schermo &quot;file eliminato correttamente&quot;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;; text-align: left;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;  9. &lt;/b&gt;Lo studente clicca sul pulsante &quot;OK&quot;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;; text-align: left;&quot;&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;  1&lt;b&gt;0. &lt;/b&gt;Il sistema mostra a schermo la schermata contenente i file&lt;/span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;; text-align: left;&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;/div&gt;" vertex="1">
