        </mxCell>
        <mxCell id="6aRgRBSg-gLDWoQgza2K-15" parent="6aRgRBSg-gLDWoQgza2K-14" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;b&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Flusso degli eventi&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="310" width="380" as="geometry">
            <mxRectangle height="310" width="380" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="6aRgRBSg-gLDWoQgza2K-16" parent="6aRgRBSg-gLDWoQgza2K-14" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;b&gt;1&lt;/b&gt;. &lt;/span&gt;Lo studente clicca sul pulsante &quot;UPLOAD&quot;.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;b&gt;2&lt;/b&gt;. &lt;/span&gt;Il Sistema mostra a video la&amp;nbsp;&lt;/span&gt;&lt;span data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;29&quot; style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;Schermata di Caricamento&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&amp;nbsp;contenente i campi &quot;Titolo&quot;, &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;    &lt;/span&gt;&quot;Descrizione&quot;, il pulsante &quot;Scegli File&quot; e il pulsante &quot;Conferma&quot;.&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;b&gt;3&lt;/b&gt;. &lt;/span&gt;Lo studente compila i campi &quot;Titolo&quot; e &quot;Descrizione&quot;.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;b&gt;4&lt;/b&gt;. &lt;/span&gt;Lo studente clicca su &quot;Scegli File&quot;, seleziona il file dal proprio dispositivo e lo allega.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;b&gt;5&lt;/b&gt;. &lt;/span&gt;Lo studente clicca sul pulsante &quot;Conferma&quot;.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;b&gt;6&lt;/b&gt;. &lt;/span&gt;Il Sistema verifica le dimensioni del file associato.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b data-path-to-node=&quot;5,6,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;7. &lt;/span&gt;SE&lt;/b&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&amp;nbsp;supera le dimensioni massime:&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;b&gt;7.1&lt;/b&gt;. Il sistema mostra a schermo il messaggio di errore :&quot;File troppo grande&quot;.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;b&gt;7.2&lt;/b&gt;. Lo studente clicca su &quot;OK&quot;.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;b&gt;7.3&lt;/b&gt;. Il sistema mostra a schermo la schermata contenente i file.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b data-path-to-node=&quot;5,7,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;8. &lt;/span&gt;ALTRIMENTI&lt;/b&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&amp;nbsp;(Dimensioni massime non superate):&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;8.1&lt;/span&gt; Il sistema recupera dalla memoria temporanea l&#39;identificativo dello studente&lt;/font&gt;&lt;/div&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;b&gt;8.2&lt;/b&gt;. Il Sistema memorizza il contenuto all&#39;interno del DBMS.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;b&gt;8.3&lt;/b&gt;. Il sistema mostra a schermo il messaggio: &quot;File caricato con successo&quot;.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;b&gt;8.4&lt;/b&gt;. Lo studente clicca su &quot;OK&quot;.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;b&gt;8.5&lt;/b&gt;. Il Sistema mostra la schermata contenente i file.&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="310" width="510" x="380" as="geometry">
            <mxRectangle height="310" width="510" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
