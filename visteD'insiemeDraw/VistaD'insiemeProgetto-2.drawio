        <mxCell id="j6LiemEWmGd-EiNNAa9P-33" parent="j6LiemEWmGd-EiNNAa9P-20" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="328" width="810" y="165" as="geometry" />
        </mxCell>
        <mxCell id="j6LiemEWmGd-EiNNAa9P-34" parent="j6LiemEWmGd-EiNNAa9P-33" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;b&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Flusso degli eventi&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="328" width="320" as="geometry">
            <mxRectangle height="328" width="320" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="j6LiemEWmGd-EiNNAa9P-35" parent="j6LiemEWmGd-EiNNAa9P-33" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;b&gt;1&lt;/b&gt;.Lo studente clicca sulla sezione &quot;Gestisci codici&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;2.&lt;b&gt; &lt;/b&gt;Il sistema recupera dalla memoria temporanea l&#39; identificativo dello studente&lt;br&gt;&lt;b&gt;2&lt;/b&gt;.Il Sistema interroga il DBMS per recuperare la lista dei codici generati dallo studente.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;b data-path-to-node=&quot;6,2,0&quot; data-index-in-node=&quot;0&quot;&gt;3. SE&lt;/b&gt;&amp;nbsp;lo studente non possiede alcun codice generato:&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;b&gt;3.1&lt;/b&gt;. Il Sistema mostra a video un messaggio di errore: &quot;Nessun codice generato&quot;,&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;b&gt;3.2&lt;/b&gt;. Lo studente clicca sul pulsante &quot;ok&quot;.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;b&gt;3.3&lt;/b&gt;. Il Sistema mostra a video la schermata &quot;Gestione Condivisione Interna&quot;.&lt;br&gt;&lt;b data-path-to-node=&quot;6,3,0&quot; data-index-in-node=&quot;0&quot;&gt;4. ALTRIMENTI&lt;/b&gt;&amp;nbsp;(Ci sono codici generati):&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;b&gt;4.1.&lt;/b&gt; Il Sistema mostra a video la schermata &quot;Elenco Codici&quot;, contenente l&#39;elenco dei &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;codici&lt;/span&gt;&amp;nbsp; e il pulsante &quot;Revoca&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;font&gt;&lt;b data-path-to-node=&quot;6,0,0&quot; data-index-in-node=&quot;209&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="328" width="490" x="320" as="geometry">
            <mxRectangle height="328" width="490" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
