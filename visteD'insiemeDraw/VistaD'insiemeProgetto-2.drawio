        <mxCell id="MaxNqh8uD9rA1T1gAg1p-13" parent="MaxNqh8uD9rA1T1gAg1p-11" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=center;" value="&lt;font face=&quot;Times New Roman&quot;&gt;Il sistema ha mostrato a schermo la Home Afam&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="410" x="380" as="geometry">
            <mxRectangle height="30" width="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="MaxNqh8uD9rA1T1gAg1p-14" parent="MaxNqh8uD9rA1T1gAg1p-1" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="310" width="790" y="160" as="geometry" />
        </mxCell>
        <mxCell id="MaxNqh8uD9rA1T1gAg1p-15" parent="MaxNqh8uD9rA1T1gAg1p-14" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;b&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Flusso degli eventi&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="310" width="380" as="geometry">
            <mxRectangle height="310" width="380" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="MaxNqh8uD9rA1T1gAg1p-16" parent="MaxNqh8uD9rA1T1gAg1p-14" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;b&gt;1&lt;/b&gt;. Lo studente clicca sul pulsante &quot;Gestione Contenuti&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;div&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;2  &lt;/span&gt;Il sistema recupera dalla memoria temporanea l&#39;identificativo dello studente&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;b&gt;3&lt;/b&gt;&lt;/span&gt;. Il Sistema interroga il DBMS per recuperare la lista delle Categorie &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;    &lt;/span&gt;Artistiche associate allo studente.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;b&gt;4&lt;/b&gt;&lt;/span&gt;. Il Sistema mostra a video la schermata &quot;Gestione Contenuti&quot;, elencando le &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;    &lt;/span&gt;Categorie Artistiche esistenti e il pulsante &quot;Crea Nuova Categoria Artistica&quot;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;b&gt;5&lt;/b&gt;&lt;/span&gt;. Lo studente clicca sul pulsante &quot;Crea Nuova Categoria Artistica&quot;.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;b&gt;6&lt;/b&gt;&lt;/span&gt;. Il Sistema mostra a video il form di inserimento &quot;Nuova Categoria &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;    &lt;/span&gt;Artistica&quot;.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;b&gt;7&lt;/b&gt;&lt;/span&gt;. Lo studente inserisce il nome della nuova Categoria Artistica e clicca sul &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;    &lt;/span&gt;pulsante &quot;Salva&quot;.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;b&gt;8&lt;/b&gt;&lt;/span&gt;. Il Sistema invia il nome della nuova Categoria Artistica al DBMS per il &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;    &lt;/span&gt;salvataggio permanente.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;b&gt;9&lt;/b&gt;&lt;/span&gt;. Il Sistema mostra a video il messaggio di conferma &quot;Categoria Artistica &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;    &lt;/span&gt;creata con successo&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;      10&lt;/b&gt;&lt;/span&gt;. Lo studente clicca sul pulsante &quot;ok&quot; per chiudere il messaggio.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&amp;nbsp;     &lt;/span&gt;&lt;b&gt;11&lt;/b&gt;. Il Sistema mostra a video la schermata &quot;Scelta Tipologia File&quot; relativa alla &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;    &lt;/span&gt;categoria appena creata.&lt;/font&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="310" width="410" x="380" as="geometry">
            <mxRectangle height="310" width="410" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
