        <mxCell id="rBFPTPXUp2qlC89oPuT--13" parent="rBFPTPXUp2qlC89oPuT--11" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=center;" value="&lt;font face=&quot;Times New Roman&quot;&gt;Il sistema ha mostrato a schermo il file che lo studente vuole condividere&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="420" x="380" as="geometry">
            <mxRectangle height="40" width="420" as="alternateBounds" />
