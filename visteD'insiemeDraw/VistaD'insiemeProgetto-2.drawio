        <mxCell id="48mQKfHj96o4jcNBYrxQ-13" parent="48mQKfHj96o4jcNBYrxQ-11" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=center;" value="&lt;font face=&quot;Times New Roman&quot;&gt;Il sistema ha mostrato a schermo la schermata principale&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="580" x="380" as="geometry">
