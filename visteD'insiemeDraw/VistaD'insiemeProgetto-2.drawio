          <mxGeometry height="151" width="430" as="geometry">
            <mxRectangle height="151" width="430" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="48mQKfHj96o4jcNBYrxQ-57" parent="48mQKfHj96o4jcNBYrxQ-55" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;b&gt;1.&lt;/b&gt;Il sistema mostra a video la schermata di login&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;2. Il sistema mostra&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;a video la schermata per la registrazione&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="151" width="500" x="430" as="geometry">
            <mxRectangle height="151" width="500" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
